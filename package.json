{
  "name": "dsh-github-repo-search",
  "version": "1.4.1",
  "type": "module",
  "description": "DeepSeek Harness plugin: search GitHub repositories, code, issues and trends from chat, then revisit, star, compare and keep a cross-session history of what you searched in a right-sidebar panel.",
  "license": "MIT",
  "author": "ZhaoDezhang9998",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "github-search",
    "repository-search",
    "code-search",
    "agent-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhaoDezhang9998/dsh-github-repo-search.git"
  },
  "homepage": "https://github.com/ZhaoDezhang9998/dsh-github-repo-search#readme",
  "bugs": {
    "url": "https://github.com/ZhaoDezhang9998/dsh-github-repo-search/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
